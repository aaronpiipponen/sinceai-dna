# Copy this file to app/.env, then fill in your key.
# app/.env is git-ignored; never commit it.

FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

